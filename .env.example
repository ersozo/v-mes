# Kopyalayın: cp .env.example .env  — ve tüm şifreleri değiştirin.

# --- Genel ---
TZ_PLANT=Europe/Istanbul
EDGE_ID=edge-01

# --- MS SQL Server ---
# En az 8 karakter, büyük/küçük harf, rakam ve sembol içermeli.
MSSQL_SA_PASSWORD=ChangeMe_Sa_2026!
MSSQL_PORT=1433
MSSQL_DB=MES_DB
# Uygulama servislerinin kullandığı (sa olmayan) kullanıcı
MSSQL_APP_USER=mes_app
MSSQL_APP_PASSWORD=ChangeMe_App_2026!

# --- EMQX ---
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=ChangeMe_Emqx_2026
MQTT_PORT=1883
EMQX_DASHBOARD_PORT=18083
# MQTT servis hesapları (ilk açılışta EMQX'e yüklenir; sonradan değiştirmek için README'ye bakın)
MQTT_NODERED_USER=nodered
MQTT_NODERED_PASSWORD=ChangeMe_Mqtt_Nodered
MQTT_INGESTION_USER=ingestion
MQTT_INGESTION_PASSWORD=ChangeMe_Mqtt_Ingestion

# --- Node-RED ---
NODERED_PORT=1880
NODERED_ADMIN_USER=admin
NODERED_ADMIN_PASSWORD=ChangeMe_Nodered_2026
# Node-RED credential dosyasını şifreler; değiştirirseniz mevcut credential'lar okunamaz.
NODERED_CREDENTIAL_SECRET=change-me-to-a-long-random-string

# --- Simülatör (geliştirme) ---
# dev profili simülatörü de başlatır; üretimde bu satırı kaldırın.
COMPOSE_PROFILES=dev
SIMULATOR_CONTROL_PORT=8090

# --- Uygulama ---
# API ve ingestion'ın paylaştığı JWT imza anahtarı (en az 32 karakter): openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
INGESTION_PORT=3001
API_PORT=8000
# Üretimde HTTPS arkasında true olmalı (refresh token çerezi yalnızca HTTPS'te gönderilir)
COOKIE_SECURE=false
# Sistemde hiç kullanıcı yoksa ilk açılışta bu admin hesabı oluşturulur (en az 10 karakter, büyük/küçük harf ve rakam)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe_Admin_2026
CORS_ORIGIN=*
WEB_PORT=8080

# --- Üretim ---
# MSSQL lisans sürümü (Developer üretimde kullanılamaz)
MSSQL_PID=Developer
# Saha edge'leri broker'a TLS (8883) ile bağlansın mı (Node-RED akışları buna göre üretilir)
FLOW_MQTT_TLS=false
LOG_LEVEL=info
BACKUP_KEEP_DAYS=14

# --- Harici edge (ör. HUBBOX içindeki Node-RED) ---
# Boş bırakılırsa compose'daki Node-RED kullanılır (geliştirme).
#EDGE_NODERED_URL=http://10.146.168.19:1880
#EDGE_NODERED_USER=
#EDGE_NODERED_PASSWORD=
# Edge'in ortam değişkenlerini yönetemiyorsak "inline": MQTT bilgileri akışa yazılır (şifre Node-RED'de şifreli saklanır)
#FLOW_MQTT_MODE=inline
# Edge'in broker'a ulaşacağı adres: uygulamanın çalıştığı sanal makinenin kurumsal ağdaki IP'si
#FLOW_MQTT_HOST=10.146.x.x
#FLOW_MQTT_USER=nodered
#FLOW_MQTT_PASSWORD=ChangeMe_Mqtt_Nodered
# TLS kullanılacaksa CA dosyasının EDGE ÜZERİNDEKİ yolu
#FLOW_MQTT_CA_FILE=/data/certs/ca.crt
